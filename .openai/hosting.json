{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "cds-backend": {
      "root": "cds-backend"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "cds-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
